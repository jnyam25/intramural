# Vercel / local environment variables
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-value
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xyz.mongodb.net/?appName=Cluster0

# Field-level encryption / Queryable Encryption
# MONGO_LOCAL_MASTER_KEY: base64-encoded 96-byte random key.
# Generate with: node -e "console.log(require('crypto').randomBytes(96).toString('base64'))"
MONGO_DEK_ID=replace-with-your-data-encryption-key-hex
MONGO_LOCAL_MASTER_KEY=replace-with-base64-encoded-96-byte-random-key

# Sprint 1: single pilot school. Run scripts/seed-pilot-school.ts to generate.
# Sprint 5 replaces this with per-school SSO + domain-to-school mapping.
PILOT_SCHOOL_ID=replace-with-output-of-seed-script

# Optional: restrict sign-ups to a specific email domain (e.g. "university.edu").
# Leave unset to allow any email during local development.
PILOT_SCHOOL_DOMAIN=

# Optional: debugging only
NEXTAUTH_DEBUG=true

# Local dev test credentials (DO NOT USE IN PRODUCTION)
# Use these to perform quick sign-in tests against the local DB/NextAuth setup.
TEST_USER_EMAIL=test.user+dev@intramural.local
TEST_USER_PASSWORD=TestPassword123!
